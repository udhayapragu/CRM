# ─────────────────────────────────────────────────────────────
# Luxe CRM — environment template. Copy to `.env` and fill in.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL="postgresql://luxe:luxe_password@localhost:5432/luxe_crm?schema=public"

# Public base URL of this CRM (used for webhook URLs and CSRF origin checks)
APP_URL="http://localhost:3000"

# 32-byte key (base64) used to encrypt WordPress API credentials at rest (AES-256-GCM).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing this key makes previously stored credentials unreadable (re-enter them).
APP_ENCRYPTION_KEY=""

# Required in production to create the first Super Admin at /setup.
# Generate a long random value and keep it private; remove/rotate after setup.
SETUP_TOKEN=""

# Secret for the cron endpoint (POST /api/cron/tick, header: Authorization: Bearer <CRON_SECRET>)
# Needed only if you schedule syncs through an external cron instead of `npm run worker`.
CRON_SECRET=""

# Session lifetime in hours (default 12)
SESSION_TTL_HOURS="12"

# Allow http:// (non-TLS) WordPress URLs. Keep "false" in production — credentials would travel in clear text.
ALLOW_INSECURE_WORDPRESS_HTTP="false"

# Directory for onboarding document uploads (use a persistent volume in production)
UPLOAD_DIR="./uploads"
# Max upload size in megabytes
UPLOAD_MAX_MB="15"

# Background worker poll interval in seconds
WORKER_POLL_SECONDS="30"

# Optional notification channels (disabled unless configured)
SMTP_URL=""
NOTIFY_EMAIL_FROM=""
WHATSAPP_WEBHOOK_URL=""

# Business timezone for "today" metrics and day/week/month buckets (IANA name)
TZ="Asia/Kolkata"

# Optional: direct (non-pooled) connection used only for migrations when DATABASE_URL is a pooler
DIRECT_URL=""
# Optional: seconds of sync work per request on serverless hosts (default 40 on Vercel, unlimited elsewhere)
SYNC_TIME_BUDGET_SECONDS=""
