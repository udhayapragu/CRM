// Luxe CRM — database schema
//
// Conventions
// - `source`  : where a record came from (WORDPRESS sync, MANUAL entry in the CRM, or DEMO data).
// - `isDemo`  : true for sample data created by the demo environment. Demo data must be cleared
//               before a real WordPress connection can sync.
// - Synchronized WordPress fields are prefixed `wp`/`wc` and are read-only inside the CRM.
// - Physical stock is NEVER stored as a free-edited number: it is derived from the append-only
//   InventoryLedgerEntry table. Cached totals on InventoryItem/StockLevel are updated in the same
//   database transaction as the ledger insert and can be re-verified at any time.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Users, sessions, permissions ─────────────────────────────

enum Role {
  SUPER_ADMIN
  INVENTORY_MANAGER
  ORDER_MANAGER
  DISPATCH_MANAGER
  ONBOARDING_MANAGER
  ACCOUNTANT
  VIEWER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(VIEWER)
  active       Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions            Session[]
  ledgerEntries       InventoryLedgerEntry[]
  auditLogs           AuditLog[]
  orderEvents         OrderEvent[]
  notificationReads   NotificationRead[]
  onboardingOwned     OnboardingItem[]       @relation("OnboardingOwner")
  onboardingTasks     OnboardingTask[]       @relation("TaskAssignee")
  onboardingComments  OnboardingComment[]
  onboardingDocuments OnboardingDocument[]
  purchaseReceipts    PurchaseReceipt[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ───────────────────────────── WordPress integration ─────────────────────────────

enum DataSource {
  WORDPRESS
  MANUAL
  DEMO
}

enum ConnectionAdapter {
  WOOCOMMERCE
  WP_POST_TYPE
}

enum ConnectionStatus {
  UNTESTED
  CONNECTED
  ERROR
  DISCONNECTED
}

model WordPressConnection {
  id                   String            @id @default(cuid())
  name                 String            @default("My WordPress site")
  siteUrl              String
  adapter              ConnectionAdapter @default(WOOCOMMERCE)
  // Encrypted (AES-256-GCM) credentials. Never sent to the browser.
  consumerKeyEnc       String?
  consumerSecretEnc    String?
  wpUsername           String?
  appPasswordEnc       String?
  webhookSecretEnc     String?
  // Generic WP adapter options (post type + meta key mapping)
  adapterOptions       Json?
  // Detection results from Test Connection
  wooCommerceDetected  Boolean?
  wpVersionInfo        String?
  siteName             String?
  namespaces           String[]          @default([])
  status               ConnectionStatus  @default(UNTESTED)
  lastTestedAt         DateTime?
  lastTestMessage      String?
  enabled              Boolean           @default(false)
  syncIntervalMinutes  Int               @default(15)
  perPage              Int               @default(50)
  lastSyncAt           DateTime?
  lastSuccessfulSyncAt DateTime?
  productsCursor       DateTime?
  ordersCursor         DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  products      Product[]
  orders        Order[]
  syncJobs      SyncJob[]
  webhookEvents WebhookEvent[]
}

enum SyncJobType {
  PRODUCTS
  ORDERS
  FULL
}

enum SyncTrigger {
  MANUAL
  SCHEDULED
  WEBHOOK
  INITIAL
  RETRY
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

model SyncJob {
  id           String              @id @default(cuid())
  connectionId String
  connection   WordPressConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  type         SyncJobType
  trigger      SyncTrigger
  status       SyncJobStatus       @default(QUEUED)
  fullResync   Boolean             @default(false)
  attempts     Int                 @default(0)
  maxAttempts  Int                 @default(4)
  runAfter     DateTime            @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  lockedAt     DateTime?
  lockedBy     String?
  stats        Json?
  error        String?
  requestedBy  String?
  retryOfId    String?
  createdAt    DateTime            @default(now())

  logs SyncLog[]

  @@index([status, runAfter])
  @@index([connectionId, createdAt])
}

model SyncLog {
  id        String   @id @default(cuid())
  jobId     String
  job       SyncJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  level     String // info | warn | error
  message   String
  context   Json?
  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
}

model WebhookEvent {
  id           String              @id @default(cuid())
  connectionId String
  connection   WordPressConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  deliveryId   String
  topic        String
  resourceId   String?
  status       String // received | processed | ignored | failed
  error        String?
  receivedAt   DateTime            @default(now())
  processedAt  DateTime?

  @@unique([connectionId, deliveryId])
  @@index([receivedAt])
}

// ───────────────────────────── Products (synchronized catalogue) ─────────────────────────────

model Product {
  id                String               @id @default(cuid())
  connectionId      String?
  connection        WordPressConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  externalId        String?
  source            DataSource           @default(MANUAL)
  isDemo            Boolean              @default(false)
  name              String
  sku               String?
  slug              String?
  type              String               @default("simple")
  imageUrl          String?
  permalink         String?
  categories        String[]             @default([])
  price             Decimal?             @db.Decimal(12, 2)
  regularPrice      Decimal?             @db.Decimal(12, 2)
  salePrice         Decimal?             @db.Decimal(12, 2)
  currency          String?
  // Status as reported by WordPress: publish | draft | pending | private
  wpStatus          String               @default("publish")
  // Website stock exactly as reported by WooCommerce (read-only, never used as physical stock)
  wpManageStock     Boolean              @default(false)
  wpStockQuantity   Int?
  wpStockStatus     String?
  lowStockThreshold Int                  @default(10)
  externalCreatedAt DateTime?
  externalUpdatedAt DateTime?
  syncedAt          DateTime?
  deletedAtSource   DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  variants         ProductVariant[]
  inventoryItems   InventoryItem[]
  orderItems       OrderItem[]
  consumptionRules ConsumptionRule[]
  onboardingItems  OnboardingItem[]

  @@unique([connectionId, externalId])
  @@index([sku])
  @@index([wpStatus])
  @@index([isDemo])
}

model ProductVariant {
  id              String    @id @default(cuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  externalId      String?
  sku             String?
  name            String
  attributes      Json?
  price           Decimal?  @db.Decimal(12, 2)
  wpStockQuantity Int?
  wpStockStatus   String?
  isDemo          Boolean   @default(false)
  syncedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  inventoryItems InventoryItem[]
  orderItems     OrderItem[]

  @@unique([productId, externalId])
  @@index([sku])
}

// ───────────────────────────── Inventory & ledger ─────────────────────────────

enum InventoryCategory {
  PRODUCT
  BOTTLE
  LABEL
  CAP
  BOX
  PACKAGING
  RAW_MATERIAL
  OTHER
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  gstOrTaxId  String?
  notes       String?
  isDemo      Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items    InventoryItem[]
  receipts PurchaseReceipt[]
}

model InventoryLocation {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  stockLevels   StockLevel[]
  ledgerEntries InventoryLedgerEntry[]
}

model InventoryItem {
  id             String            @id @default(cuid())
  name           String
  sku            String            @unique
  category       InventoryCategory
  customCategory String?
  unit           String            @default("pcs")
  reorderLevel   Int               @default(0)
  supplierId     String?
  supplier       Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  // Link to the synchronized catalogue product (only for category PRODUCT)
  productId      String?
  product        Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId      String?
  variant        ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  notes          String?
  active         Boolean           @default(true)
  isDemo         Boolean           @default(false)

  // Cached ledger totals — maintained transactionally by the ledger service, verifiable via recompute.
  qtyOpening     Int       @default(0)
  qtyReceived    Int       @default(0)
  qtyConsumed    Int       @default(0)
  qtyDispatched  Int       @default(0)
  qtyReturned    Int       @default(0)
  qtyDamaged     Int       @default(0)
  qtyAdjusted    Int       @default(0)
  qtyOnHand      Int       @default(0)
  qtyReserved    Int       @default(0)
  lastMovementAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockLevels   StockLevel[]
  ledgerEntries InventoryLedgerEntry[]
  reservations  StockReservation[]
  receiptLines  PurchaseReceiptLine[]
  usedInRules   ConsumptionRule[]      @relation("RuleMaterial")

  @@index([category])
  @@index([productId])
  @@index([isDemo])
}

model StockLevel {
  itemId     String
  item       InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId String
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  qtyOnHand  Int               @default(0)
  updatedAt  DateTime          @updatedAt

  @@id([itemId, locationId])
}

enum LedgerType {
  OPENING
  RECEIPT
  CONSUMPTION
  DISPATCH
  RETURN
  DAMAGE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

// Append-only. Never updated or deleted; corrections are made with new (reversing) entries.
model InventoryLedgerEntry {
  id             String            @id @default(cuid())
  itemId         String
  item           InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  locationId     String
  location       InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  type           LedgerType
  // Signed change to physical on-hand stock (e.g. +200 receipt, -150 consumption)
  quantity       Int
  balanceAfter   Int
  reason         String
  referenceType  String?
  referenceId    String?
  // Guarantees one ledger entry per business event (prevents double deductions on retries)
  idempotencyKey String?           @unique
  userId         String?
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  isDemo         Boolean           @default(false)
  createdAt      DateTime          @default(now())

  @@index([itemId, createdAt])
  @@index([type, createdAt])
  @@index([referenceType, referenceId])
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

model StockReservation {
  id          String            @id @default(cuid())
  itemId      String
  item        InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([orderItemId, itemId])
  @@index([itemId, status])
}

// Bill of materials: dispatching 1 unit of `productId` consumes `quantityPerUnit` of `materialId`.
model ConsumptionRule {
  id              String        @id @default(cuid())
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId      String
  material        InventoryItem @relation("RuleMaterial", fields: [materialId], references: [id], onDelete: Cascade)
  quantityPerUnit Int
  active          Boolean       @default(true)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([productId, materialId])
}

model PurchaseReceipt {
  id          String    @id @default(cuid())
  number      String    @unique
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoiceRef  String?
  receivedAt  DateTime  @default(now())
  notes       String?
  totalCost   Decimal?  @db.Decimal(14, 2)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  isDemo      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  lines PurchaseReceiptLine[]
}

model PurchaseReceiptLine {
  id        String          @id @default(cuid())
  receiptId String
  receipt   PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  itemId    String
  item      InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity  Int
  unitCost  Decimal?        @db.Decimal(12, 2)
}

// ───────────────────────────── Orders & fulfilment ─────────────────────────────

enum OrderStatus {
  NEW
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  READY_TO_PACK
  READY_TO_DISPATCH
  DISPATCHED
  DELIVERED
  ON_HOLD
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum ShippingStatus {
  NOT_SHIPPED
  PACKED
  AWAITING_PICKUP
  IN_TRANSIT
  DELIVERED
  RETURNED
}

model Order {
  id                   String               @id @default(cuid())
  connectionId         String?
  connection           WordPressConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  externalId           String?
  number               String
  source               DataSource           @default(MANUAL)
  isDemo               Boolean              @default(false)
  // Raw WooCommerce status as last seen (pending, processing, on-hold, completed, cancelled, refunded, failed)
  wcStatus             String?
  status               OrderStatus          @default(NEW)
  paymentStatus        PaymentStatus        @default(UNPAID)
  shippingStatus       ShippingStatus       @default(NOT_SHIPPED)
  customerName         String
  customerEmail        String?
  customerPhone        String?
  billingAddress       Json?
  shippingAddress      Json?
  shippingMethod       String?
  paymentMethod        String?
  currency             String               @default("INR")
  subtotal             Decimal              @default(0) @db.Decimal(12, 2)
  shippingTotal        Decimal              @default(0) @db.Decimal(12, 2)
  taxTotal             Decimal              @default(0) @db.Decimal(12, 2)
  discountTotal        Decimal              @default(0) @db.Decimal(12, 2)
  total                Decimal              @default(0) @db.Decimal(12, 2)
  refundedTotal        Decimal              @default(0) @db.Decimal(12, 2)
  customerNote         String?
  internalNotes        String?
  orderDate            DateTime
  paidAt               DateTime?
  expectedDispatchDate DateTime?
  needsAttention       Boolean              @default(false)
  attentionReason      String?
  externalUpdatedAt    DateTime?
  syncedAt             DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  items        OrderItem[]
  events       OrderEvent[]
  shipments    Shipment[]
  reservations StockReservation[]
  returns      OrderReturn[]
  memberSale   MemberSale?
  commissions  Commission[]

  @@unique([connectionId, externalId])
  @@index([status])
  @@index([orderDate])
  @@index([isDemo])
}

model OrderItem {
  id                  String          @id @default(cuid())
  orderId             String
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  externalId          String?
  productId           String?
  product             Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId           String?
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Source product/variation ids, kept so lines can be linked once the product is synchronised
  externalProductId   String?
  externalVariationId String?
  name                String
  sku                 String?
  quantity            Int
  unitPrice           Decimal         @default(0) @db.Decimal(12, 2)
  total               Decimal         @default(0) @db.Decimal(12, 2)
  // Fulfilment counters maintained transactionally — cannot exceed `quantity`.
  packedQty           Int             @default(0)
  dispatchedQty       Int             @default(0)
  returnedQty         Int             @default(0)

  reservations  StockReservation[]
  shipmentLines ShipmentLine[]
  returnLines   OrderReturnLine[]

  @@unique([orderId, externalId])
  @@index([productId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // STATUS | PAYMENT | SHIPPING | NOTE | SYNC | STOCK | RETURN
  fromValue String?
  toValue   String?
  message   String
  // USER | SYNC | WEBHOOK | SYSTEM
  actor     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

enum ShipmentStatus {
  PACKED
  AWAITING_PICKUP
  IN_TRANSIT
  DELIVERED
  RETURNED
  CANCELLED
}

model Shipment {
  id                 String         @id @default(cuid())
  orderId            String
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status             ShipmentStatus @default(PACKED)
  courier            String?
  trackingNumber     String?
  trackingUrl        String?
  notes              String?
  packedAt           DateTime       @default(now())
  packedById         String?
  dispatchedAt       DateTime?
  dispatchedById     String?
  expectedDeliveryAt DateTime?
  deliveredAt        DateTime?
  deliveredById      String?
  deliveryNote       String?
  isDemo             Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  lines ShipmentLine[]

  @@index([status])
  @@index([dispatchedAt])
}

model ShipmentLine {
  id          String    @id @default(cuid())
  shipmentId  String
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity    Int

  @@unique([shipmentId, orderItemId])
}

model OrderReturn {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason      String
  receivedAt  DateTime @default(now())
  createdById String?
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())

  lines OrderReturnLine[]
}

model OrderReturnLine {
  id          String      @id @default(cuid())
  returnId    String
  orderReturn OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity    Int
  // RESTOCK = back to sellable stock, DAMAGED = returned but written off
  condition   String
}

// ───────────────────────────── Product onboarding ─────────────────────────────

model OnboardingStage {
  id         String   @id @default(cuid())
  key        String   @unique
  name       String
  position   Int
  color      String   @default("#8b5cf6")
  isTerminal Boolean  @default(false)
  createdAt  DateTime @default(now())

  items OnboardingItem[]
}

model OnboardingItem {
  id             String          @id @default(cuid())
  title          String
  sku            String?
  category       String?
  description    String?
  stageId        String
  stage          OnboardingStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  priority       String          @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  ownerId        String?
  owner          User?           @relation("OnboardingOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  dueDate        DateTime?
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  holdReason     String?
  isDemo         Boolean         @default(false)
  stageEnteredAt DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tasks     OnboardingTask[]
  comments  OnboardingComment[]
  documents OnboardingDocument[]

  @@index([stageId])
}

model OnboardingTask {
  id         String         @id @default(cuid())
  itemId     String
  item       OnboardingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  title      String
  assigneeId String?
  assignee   User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate    DateTime?
  done       Boolean        @default(false)
  doneAt     DateTime?
  createdAt  DateTime       @default(now())
}

model OnboardingComment {
  id        String         @id @default(cuid())
  itemId    String
  item      OnboardingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime       @default(now())
}

model OnboardingDocument {
  id           String         @id @default(cuid())
  itemId       String
  item         OnboardingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String         @unique
  uploadedById String?
  uploadedBy   User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
}

// ───────────────────────────── Notifications ─────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  type      String // LOW_STOCK | OUT_OF_STOCK | NEW_ORDER | PENDING_DISPATCH | DELAYED_SHIPMENT | SYNC_FAILED | ONBOARDING_APPROVAL | INVENTORY_ADJUSTMENT | STOCK_DISCREPANCY
  severity  String   @default("info") // info | warning | critical
  title     String
  message   String
  link      String?
  // Roles allowed to see it (empty = everyone)
  roles     Role[]   @default([])
  dedupeKey String?  @unique
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  reads NotificationRead[]

  @@index([createdAt])
}

model NotificationRead {
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([notificationId, userId])
}

// ───────────────────────────── MLM / direct selling (optional module) ─────────────────────────────
// Commissions are ONLY generated from verified product sales under explicitly configured rules that
// are marked as legally reviewed. There is no code path that rewards recruitment or registration.

enum MemberStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Member {
  id           String       @id @default(cuid())
  referralCode String       @unique
  name         String
  email        String?
  phone        String?
  sponsorId    String?
  sponsor      Member?      @relation("Sponsorship", fields: [sponsorId], references: [id], onDelete: SetNull)
  downline     Member[]     @relation("Sponsorship")
  status       MemberStatus @default(PENDING)
  joinedAt     DateTime     @default(now())
  activatedAt  DateTime?
  notes        String?
  isDemo       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sales       MemberSale[]
  commissions Commission[]
  payouts     Payout[]

  @@index([sponsorId])
}

model MemberSale {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model CommissionRule {
  id              String    @id @default(cuid())
  name            String
  // 1 = the member who made the sale, 2 = their sponsor, ... (only for sales, never for recruitment)
  level           Int
  ratePercent     Decimal   @db.Decimal(6, 3)
  active          Boolean   @default(false)
  legallyReviewed Boolean   @default(false)
  reviewedBy      String?
  reviewedAt      DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  commissions Commission[]
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  VOID
  REVERSED
}

model Commission {
  id           String           @id @default(cuid())
  memberId     String
  member       Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  orderId      String
  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ruleId       String
  rule         CommissionRule   @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  level        Int
  baseAmount   Decimal          @db.Decimal(12, 2)
  ratePercent  Decimal          @db.Decimal(6, 3)
  amount       Decimal          @db.Decimal(12, 2)
  status       CommissionStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  payoutId     String?
  payout       Payout?          @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  // Negative adjustment entries (returns/refunds after a commission was paid) point at the original accrual
  adjustsId    String?
  adjusts      Commission?      @relation("Adjustment", fields: [adjustsId], references: [id], onDelete: SetNull)
  adjustments  Commission[]     @relation("Adjustment")
  note         String?
  // Idempotency key: "c:<orderId>:<ruleId>:<memberId>" for accruals, "adj:<commissionId>:<n>" for adjustments
  key          String           @unique
  isDemo       Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
  @@index([orderId])
}

model Payout {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2)
  reference   String?
  paidAt      DateTime @default(now())
  createdById String?
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())

  commissions Commission[]
}
